[Unit]
Description=WhatsWatch
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/srv/apps/source/WhatsWatch
ExecStart=/usr/bin/npm start
Restart=always
RestartSec=10
Environment=NODE_ENV=production
Environment=HEADLESS=true
Environment=WWEBJS_DATA_PATH=/srv/apps/source/WhatsWatch/.wwebjs_auth
Environment=LOG_FILE=/srv/apps/source/WhatsWatch/messages.log
EnvironmentFile=/srv/apps/source/WhatsWatch/.env

[Install]
WantedBy=default.target
